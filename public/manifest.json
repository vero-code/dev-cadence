{
  "manifest_version": 3,
  "name": "Dev Cadence — Hackathon Capacity Planner",
  "version": "1.0.0",
  "description": "In-context side panel for Devpost to pace your hackathon workload, visualize overlap, and turn registrations into submissions.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Open Dev Cadence",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ]
}
